{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/src.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist"
  },
  "references": [
    {
      "path": "../shared"
    }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
