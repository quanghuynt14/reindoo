{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.3",
  "author": "quanghuynt14",
  "engines": {
    "node": "24.10.0",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc --build ./tsconfig.src.json",
    "dev": "NODE_ENV=development node --watch --env-file-if-exists .env src/index.ts | pino-pretty -tc",
    "worker": "NODE_ENV=development node --watch --env-file-if-exists .env src/worker.ts | pino-pretty -tc",
    "worker:prod": "node dist/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed:lexicon": "node --env-file-if-exists .env src/scripts/seedLexicon.ts",
    "check:lexicon": "node --env-file-if-exists .env src/scripts/checkLexicon.ts",
    "repair:refs": "node --env-file-if-exists .env src/scripts/repairReferences.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@practice/shared": "workspace:*",
    "@practice/task-service": "workspace:*",
    "better-auth": "1.4.7",
    "bullmq": "^5.35.2",
    "close-with-grace": "^2.3.0",
    "fastify": "catalog:fastify",
    "fastify-plugin": "catalog:fastify",
    "mongodb": "catalog:mongodb",
    "openai": "^6.9.1"
  },
  "devDependencies": {
    "@practice/eslint-config": "workspace:*",
    "@types/node": "catalog:ts",
    "json-schema-to-ts": "^3.1.1",
    "pino-pretty": "catalog:",
    "typescript": "catalog:ts"
  }
}
