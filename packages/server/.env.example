# Server Environment Variables

# MongoDB Connection String
MONGODB_URL=mongodb+srv://user:password@cluster0.example.mongodb.net/
MONGODB_DB_NAME=practice

# OpenAI API Key - Required for grammar check feature
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# HuggingFace Token
HF_TOKEN=

# Better Auth Secret
BETTER_AUTH_SECRET=

# Client URL (for CORS / trusted origins). You can provide a comma-separated list of URLs.
CLIENT_URL=https://your-client-domain.com,http://localhost:3211

# Redis Connection (for BullMQ background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Configuration
QUEUE_CONCURRENCY=5
QUEUE_RATE_LIMIT_MAX=10
QUEUE_RATE_LIMIT_DURATION=1000

# Cloudflare Turnstile (captcha)
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
