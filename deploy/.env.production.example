# ═══════════════════════════════════════════════════════════════
# Production Environment Variables
# Copy this file to .env.production and fill in real values
# ═══════════════════════════════════════════════════════════════

# MongoDB (Atlas)
#
# Sert aussi au chargement du lexique, depuis votre machine :
#   node --env-file deploy/.env.production \
#     packages/server/src/scripts/seedLexicon.ts ../dictionnaire/build/mongo-fr.ndjson
#
# Le mot de passe est dans l'URL : ce fichier ne doit jamais etre commite.
# Il est couvert par .gitignore (deploy/.env.production) - verifiez-le avec
#   git check-ignore -v deploy/.env.production
MONGODB_URL=mongodb+srv://user:password@cluster0.example.mongodb.net/
MONGODB_DB_NAME=practice

# Redis (managed by docker-compose, override only if external)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# BullMQ
QUEUE_CONCURRENCY=5
QUEUE_RATE_LIMIT_MAX=10
QUEUE_RATE_LIMIT_DURATION=1000

# Auth
BETTER_AUTH_SECRET=generate-a-strong-random-secret-here

# Client URL (your Cloudflare Workers frontend)
CLIENT_URL=https://your-client-domain.com

# API Keys
# OPENAI_API_KEY sert encore a grammarCheck et translateCheck.
# HF_TOKEN a ete retire : le dictionnaire lit le lexique en base et
# n'interroge plus aucun modele.
OPENAI_API_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
